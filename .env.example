# The app works fully offline with no configuration. Set these two values only
# to turn on the optional cloud backup (Settings > Cloud backup).
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the app bundle, so use the
# project's anon (public) key and never a service-role key.
#
# After changing them, restart the bundler: npx expo start --clear
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
