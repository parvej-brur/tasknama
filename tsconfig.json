{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "@/*": ["./src/*"],
      "@legacy/*": ["./legacy/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "legacy/**/*.ts",
    "legacy/**/*.tsx",
    "app.config.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "legacy/app"]
}
